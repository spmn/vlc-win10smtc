#include <winresrc.h>

#include "plugin.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
FILEVERSION PLUGIN_VERSION_MAJOR, PLUGIN_VERSION_MINOR, PLUGIN_VERSION_PATCH, 0
PRODUCTVERSION PLUGIN_VERSION_MAJOR, PLUGIN_VERSION_MINOR, PLUGIN_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", PLUGIN_FILE_DESCRIPTION
            VALUE "FileVersion", PLUGIN_VERSION_STR
            VALUE "InternalName", PLUGIN_SHORTNAME
            VALUE "OriginalFilename", PLUGIN_FILENAME
            VALUE "ProductName", PLUGIN_PRODUCT_NAME
            VALUE "ProductVersion", PLUGIN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
